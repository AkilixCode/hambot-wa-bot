# HamBot Configuration
# Copy this file to .env and fill in your values

# ================================
# Bot Configuration
# ================================
BOT_NAME=HamBot
BOT_OWNER=YourName
BOT_PREFIX=.

# Private Mode: Only respond to group messages (ignore DMs)
ONLY_GROUP_MODE=false

# ================================
# Security Settings
# ================================
# Bot owner's WhatsApp number (with country code, no +)
# Example: 6281234567890@s.whatsapp.net
BOT_OWNER_ID=

# Comma-separated list of owner-only commands
OWNER_ONLY_COMMANDS=security

# Chat content filtering (malicious pattern detection)
# Set to 'false' to disable - users can type anything without being flagged
# Server-side protections (rate limiting, user blocking) remain active
SECURITY_CHAT_FILTER=true

# ================================
# Performance Settings
# ================================
# Maximum concurrent heavy operations (downloads, scraping)
MAX_PROCESSES=3

# Cooldown between commands per user (milliseconds)
# Friendly default: 3 seconds
COOLDOWN_MS=3000

# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW=60000

# Maximum commands per user per window (friendly: 15)
RATE_LIMIT_MAX=15

# Cache expiration time (milliseconds)
CACHE_EXPIRATION=300000

# ================================
# Media Settings
# ================================
# Maximum music duration in seconds
MAX_MUSIC_DURATION=600

# Maximum file size for downloads (200M for data saving)
MAX_FILE_SIZE=200M

# ================================
# Proxy Settings (for yt-dlp, APIs, Puppeteer)
# ================================
# Enable proxy globally (set to true to activate)
PROXY_ENABLED=false

# Proxy type: http, https, or socks5
# For Tailscale + Every Proxy setup, use socks5 or http
PROXY_TYPE=http

# Option 1: Full proxy URL (takes priority if set)
# Supports: http://host:port, socks5://host:port, http://user:pass@host:port
# HB_PROXY_URL=socks5://100.x.x.x:1080

# Option 2: Individual components (recommended for Tailscale + Every Proxy)
# PROXY_HOST: Your Tailscale IP address (e.g., 100.x.x.x)
# PROXY_PORT: Port where Every Proxy is running (e.g., 1080 for SOCKS5, 8080 for HTTP)
PROXY_HOST=
PROXY_PORT=

# Optional: Proxy authentication (if required)
# PROXY_USER=your_proxy_username
# PROXY_PASS=your_proxy_password

# ================================
# Tailscale + Every Proxy Setup Guide:
# ================================
# 1. Install Tailscale on your spare phone and this server
# 2. Install Every Proxy app on the phone
# 3. Configure Every Proxy as SOCKS5 (port 1080) or HTTP (port 8080)
# 4. Set PROXY_HOST to your phone's Tailscale IP (e.g., 100.x.x.x)
# 5. Set PROXY_PORT to Every Proxy's port
# 6. Set PROXY_ENABLED=true
# Example config:
#   PROXY_ENABLED=true
#   PROXY_TYPE=socks5
#   PROXY_HOST=100.64.0.2
#   PROXY_PORT=1080

# ================================
# API Keys
# ================================
# Google Gemini API (for .ai command)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs TTS API (for .say command)
# Get your key from: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=plgKUYgnlZ1DCNh54DwJ

# OMDb API (for .movie command)
# Get your key from: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# ================================
# Logging
# ================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Silent mode (no console output)
LOG_SILENT=false

# ================================
# Advanced Settings
# ================================
# Node environment
NODE_ENV=production

# Memory limit (MB)
NODE_OPTIONS=--max-old-space-size=2048
