# ================================
# BOT
# ================================
BOT_NAME=HamBot
BOT_OWNER=YourName
BOT_PREFIX=.
ONLY_GROUP_MODE=false
# Line under the bot name on the .menu image and caption
# BOT_TAGLINE=Asisten WhatsApp serba bisa
# Picture on top of .menu: a file path or an http(s) URL. Without it the bot
# uses assets/menu.jpg if present, otherwise it draws its own banner.
# MENU_IMAGE=

# ================================
# HOW IT RUNS (set by ./deploy.sh)
# ================================
# docker or local. Change it with ./deploy.sh switch docker|local, which
# also moves the WhatsApp session; editing it here does not.
# DEPLOY_MODE=docker
# Local mode only: the Python that has yt-dlp (a private .venv).
# YTDLP_PYTHON=.venv/bin/python

# ================================
# LINKING THE NUMBER
# ================================
# The bot's own WhatsApp number, with country code and no "+" (e.g.
# 6281234567890). When set, the first start prints an 8-character pairing
# code to type on the phone instead of a QR code to scan. Leave empty to use
# the QR code (also saved as data/qr.png).
# PAIRING_NUMBER=
# How to link: auto (pairing code if PAIRING_NUMBER is set, falling back to
# the QR code after 2 unused codes), code, or qr. `./deploy.sh relink --qr`
# sets this for you.
# LOGIN_METHOD=auto

# ================================
# OWNER / SECURITY
# ================================
# Your WhatsApp ID (supports dual: number@s.whatsapp.net,linkedid@lid)
BOT_OWNER_ID=

# Owner-only commands (comma-separated)
OWNER_ONLY_COMMANDS=security,spam

# Chat content filtering (set false to disable)
SECURITY_CHAT_FILTER=true

# ================================
# PERFORMANCE
# ================================
MAX_PROCESSES=3
# Heavy commands (downloads, stickers) that may wait for a free slot instead
# of being told "busy". 0 = refuse straight away, as older versions did.
HEAVY_QUEUE_MAX=5
COOLDOWN_MS=3000
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=15
CACHE_EXPIRATION=300000

# ================================
# MEDIA
# ================================
MAX_MUSIC_DURATION=600

# Ceiling for .music / .video downloads. WhatsApp will not accept inline
# media anywhere near the old 200M default, and the file is streamed from
# disk, so keep this conservative.
MAX_MEDIA_SIZE=64M
# Legacy name for the same setting; MAX_MEDIA_SIZE wins if both are set.
# MAX_FILE_SIZE=64M

# YouTube player clients for yt-dlp, most preferred first.
# YouTube changes which clients work every few months, so this is an env var
# rather than something hardcoded — retune it here instead of editing code.
# Leave empty to use whatever the installed yt-dlp defaults to.
# Current known-good: default,web_safari   (the old `android` is deprecated)
YTDLP_PLAYER_CLIENTS=default,web_safari

# Optional PO token provider (bgutil-ytdlp-pot-provider, HTTP server mode).
# Raises the YouTube success rate from a datacenter IP. Not a guarantee —
# a residential proxy below is the stronger fix.
# POT_PROVIDER_URL=http://pot-provider:4416

# yt-dlp process timeouts in ms. Without these a hung download holds one of
# only MAX_PROCESSES heavy slots forever.
# YTDLP_INFO_TIMEOUT=60000
# YTDLP_DOWNLOAD_TIMEOUT=300000

# yt-dlp transport retries (0 drops the flag and keeps yt-dlp's default).
# YTDLP_SOCKET_TIMEOUT=30
# YTDLP_RETRIES=5
# YTDLP_FRAGMENT_RETRIES=10
# YTDLP_EXTRACTOR_RETRIES=3

# Optional Wallhaven key. The .pinterest fallback works without one; a key
# only raises the rate limit.
# WALLHAVEN_API_KEY=

# ================================
# PROXY (Tailscale + EveryProxy)
# ================================
# The bot's server is a datacenter IP, which YouTube treats as a bot. Routing
# media traffic through a residential connection is the fix that actually
# works. Typical setup: Every Proxy on an Android phone, with the server and
# the phone on the same Tailscale network; PROXY_HOST is the phone's tailnet IP.
#
# This is the boot-time default only. Toggle it live with:
#   .security proxy on | off | status | test
# The runtime choice is persisted in data/ and survives a restart.
# Override the directory with HAMBOT_DATA_DIR (defaults to ./data).
PROXY_ENABLED=false
PROXY_TYPE=http
PROXY_HOST=
PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=
# Full proxy URL. Overrides every PROXY_* field above if set.
# HB_PROXY_URL=

# ================================
# NETWORK
# ================================
# IPv4 only, for HTTP requests and yt-dlp alike. Set false if IPv6 works.
FORCE_IPV4=true
# Retry directly if the proxy itself is unreachable. Only failures of the
# proxy itself fall back (refused, unreachable, no answer, CONNECT refused) —
# a slow target or a YouTube bot check does not, since retrying it on the
# datacenter IP is strictly worse.
NETWORK_FALLBACK_TO_LOCAL=true
# Extra attempts for a failed GET (connection reset, timeout, 429/5xx), with
# backoff. POST is never retried. 0 disables, 5 is the maximum.
# HTTP_RETRIES=2
# Per-attempt HTTP timeout in ms.
# HTTP_TIMEOUT=30000
# How long the proxy itself may take to answer before it counts as down.
# PROXY_CONNECT_TIMEOUT=10000

# ================================
# AI CHAT (.chat)
# ================================
# Easiest: ./deploy.sh chat (asks, writes these, tests the connection).
# Full guide, every setting and the Tailscale setups: docs/ai-chat.md
# Keys stay here only: the bot never shows them in chat or in its logs.
CHAT_ENABLED=false
# Where questions go: local | provider | agent
CHAT_BACKEND=local
# Second backend for when the main one is down: none | local | provider | agent
CHAT_FALLBACK=none

# Who may use it: owner | allowlist | public
CHAT_ACCESS=owner
# For allowlist: numbers with country code and/or @lid IDs, comma-separated
CHAT_ALLOWED_USERS=
# Agents can run tools on the machine they live on, so their access is
# separate and never wider than CHAT_ACCESS: owner | allowlist | public
CHAT_AGENT_ACCESS=owner
CHAT_IN_GROUPS=true
CHAT_IN_PRIVATE=true

# AI answers being worked on at the same time (1-10); more wait in a queue
CHAT_MAX_CONCURRENT=2
CHAT_QUEUE_MAX=3
CHAT_QUEUE_WAIT_SEC=120
CHAT_COOLDOWN_SEC=5
# Daily limit per person: true to enforce CHAT_DAILY_LIMIT
CHAT_DAILY_LIMIT_ENABLED=false
CHAT_DAILY_LIMIT=20
# true = the owner is counted too
CHAT_DAILY_LIMIT_OWNER=false
# Characters per question (with the replied-to message), answer token cap,
# and how many WhatsApp messages one answer may fill
CHAT_MAX_INPUT=6000
CHAT_MAX_TOKENS=2048
CHAT_MAX_PARTS=4
# A request only times out when the AI stops responding (see the *_TIMEOUT_SEC
# settings below); one that keeps working is never cut off. Optional hard cap
# in minutes for a single answer, 0 = none.
CHAT_MAX_ACTIVE_MIN=0

# Instructions for the AI. Empty = a short built-in prompt (Indonesian,
# WhatsApp formatting). A file wins over the inline text; \n = new line.
# CHAT_SYSTEM_PROMPT=
# CHAT_SYSTEM_PROMPT_FILE=data/chat-prompt.txt
# Sampling; empty = the server's default (many current models reject them)
# CHAT_TEMPERATURE=
# CHAT_TOP_P=

# Memory: recent turns per person per chat, in memory only (never on disk)
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_TURNS=10
CHAT_MEMORY_IDLE_MIN=30
CHAT_MEMORY_MAX_CHARS=12000
CHAT_MEMORY_MAX_CHATS=500

# Replies
CHAT_QUOTED_CONTEXT=true
CHAT_SHOW_MODEL=true
CHAT_TYPING_INDICATOR=true
CHAT_STRIP_THINKING=true

# Resilience: a backend failing this many times in a row is set aside (no
# waiting on it) for CHAT_RETRY_COOLDOWN_SEC, doubling up to 10 minutes.
# A wrong key or model sets it aside at once, until fixed.
CHAT_FAIL_THRESHOLD=3
CHAT_RETRY_COOLDOWN_SEC=30
# Private message to the owner when a backend goes down / comes back
CHAT_NOTIFY_OWNER=true
# Quick reachability check of the backends at startup (logged only)
CHAT_STARTUP_CHECK=true

# --- a. Local model --------------------------------------------------
# ollama, or openai for LM Studio, llama.cpp, vLLM, LocalAI, Jan.
# Docker mode: a model on this same machine is http://host.docker.internal:PORT
CHAT_LOCAL_API=ollama
CHAT_LOCAL_URL=http://127.0.0.1:11434
CHAT_LOCAL_MODEL=
# Only if the server was started with a key
CHAT_LOCAL_API_KEY=
# Ollama only: context window and how long the model stays loaded
CHAT_LOCAL_CONTEXT=8192
CHAT_LOCAL_KEEP_ALIVE=5m
CHAT_LOCAL_STREAM=true
# No sign of life at all (includes loading the model) / silence mid-answer
CHAT_LOCAL_RESPONSE_TIMEOUT_SEC=120
CHAT_LOCAL_IDLE_TIMEOUT_SEC=60

# --- b. API provider -------------------------------------------------
# openai (any OpenAI-compatible: OpenAI, OpenRouter, Groq, DeepSeek, ...),
# anthropic or gemini. Empty URL = the official address for that API.
CHAT_PROVIDER_API=openai
CHAT_PROVIDER_URL=
CHAT_PROVIDER_API_KEY=
CHAT_PROVIDER_MODEL=
CHAT_PROVIDER_STREAM=true
CHAT_PROVIDER_RESPONSE_TIMEOUT_SEC=60
CHAT_PROVIDER_IDLE_TIMEOUT_SEC=60
# Send provider traffic through the PROXY_* proxy above (local and agent
# traffic never does)
CHAT_PROVIDER_USE_PROXY=false
# Extra headers as JSON, e.g. {"HTTP-Referer":"https://example.com"}
# CHAT_PROVIDER_HEADERS=

# --- c. Agent platform -----------------------------------------------
# hermes (Hermes Agent), openclaw, or openai for any OpenAI-style agent.
# On another machine: its Tailscale address, e.g. http://100.101.102.103:8642/v1
CHAT_AGENT_PLATFORM=hermes
CHAT_AGENT_URL=
# Hermes: API_SERVER_KEY · OpenClaw: the gateway token
CHAT_AGENT_TOKEN=
# OpenClaw: which agent (default = its default agent)
CHAT_AGENT_ID=
# Empty = the platform default (hermes-agent, openclaw/<id>)
CHAT_AGENT_MODEL=
# bot = HamBot sends the conversation; agent = the agent keeps its own session
CHAT_AGENT_MEMORY=bot
CHAT_AGENT_STREAM=true
CHAT_AGENT_RESPONSE_TIMEOUT_SEC=90
# Agents may run a silent tool (a long command) between updates
CHAT_AGENT_IDLE_TIMEOUT_SEC=180
# Files from the agent: the folder it saves them in (same path in both
# containers, read-only for HamBot). Its MEDIA:<path> lines are then sent as
# files. Empty = off. See docs/ai-chat.md#files-from-the-agent
CHAT_AGENT_MEDIA_DIR=
# Files per answer (1-10); each at most MAX_MEDIA_SIZE
CHAT_AGENT_MEDIA_MAX_FILES=5

# ================================
# API KEYS
# ================================
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=plgKUYgnlZ1DCNh54DwJ
OMDB_API_KEY=

# ================================
# LOGGING
# ================================
# simple = clean command blocks | full = verbose debug
LOG_LEVEL=simple
LOG_SILENT=false
# Network log lines, shown in both modes:
#   problems = retries, failures, proxy fallbacks, circuit changes (default)
#   all      = also every successful request
#   off      = none
NET_LOG=problems

# ================================
# ADVANCED
# ================================
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=2048
PM2_PROCESS_NAME=hambot

# ============================================
# PRESENTATION
# ============================================
# Decorative Unicode faces in headings. Set to false for plain ASCII,
# which is friendlier to screen readers.
UI_FANCY_FONT=true
# Timezone used for greetings and timestamps
BOT_TIMEZONE=Asia/Jakarta
BOT_TIMEZONE_LABEL=WIB

# Commands only group admins may run (comma-separated)
ADMIN_ONLY_COMMANDS=tagall
