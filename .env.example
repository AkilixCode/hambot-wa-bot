# HamBot Configuration
# Copy this file to .env and fill in your values
# Salin file ini ke .env dan isi nilai-nilainya

# ================================
# Konfigurasi Bot Utama
# ================================
BOT_NAME=HamBot
BOT_OWNER=YourName
BOT_PREFIX=.

# Mode Privat: Hanya merespon pesan grup (abaikan DM)
# Private Mode: Only respond to group messages (ignore DMs)
ONLY_GROUP_MODE=false

# ================================
# Pengaturan Keamanan / Security Settings
# ================================
# ID WhatsApp owner bot - MENDUKUNG DUAL ID (pisahkan dengan koma)
# Bot owner's WhatsApp ID - SUPPORTS DUAL ID (comma-separated)
#
# FORMAT: id1,id2 (bisa 1 atau 2 ID)
# 
# Mengapa perlu 2 ID?
# Why 2 IDs needed?
# - WhatsApp menggunakan format berbeda untuk chat privat vs grup
# - WhatsApp uses different formats for private chat vs group
# - Privat: nomor@s.whatsapp.net | Grup: linkedid@lid
# - Private: number@s.whatsapp.net | Group: linkedid@lid
#
# Contoh dengan 1 ID:
# Example with 1 ID:
#   BOT_OWNER_ID=6281234567890@s.whatsapp.net
#
# Contoh dengan 2 ID (direkomendasikan):
# Example with 2 IDs (recommended):
#   BOT_OWNER_ID=6281234567890@s.whatsapp.net,12345678901234@lid
#
# Cara menemukan ID Anda:
# How to find your IDs:
# 1. Kirim pesan ke bot dari chat privat, cek log untuk sender ID
#    Send message to bot from private chat, check logs for sender ID
# 2. Kirim pesan ke bot dari grup, cek log untuk sender ID
#    Send message to bot from group, check logs for sender ID
# 3. Gabungkan kedua ID dengan koma
#    Combine both IDs with comma
#
# CATATAN KEAMANAN:
# SECURITY NOTE:
# - Owner ID tidak bisa diblokir oleh perintah .security block
# - Owner ID cannot be blocked by .security block command
# - Saat restart, blokir pada owner akan otomatis dihapus
# - On restart, blocks on owner will be automatically cleared
BOT_OWNER_ID=

# Daftar perintah khusus owner (dipisahkan koma)
# List of owner-only commands (comma-separated)
# Perintah dalam daftar ini hanya bisa digunakan owner
# Commands in this list can only be used by the owner
OWNER_ONLY_COMMANDS=security,spam

# Filter konten chat (deteksi pola berbahaya)
# Chat content filtering (malicious pattern detection)
# Set 'false' untuk nonaktifkan - pengguna bisa ketik apapun tanpa diblokir
# Set to 'false' to disable - users can type anything without being flagged
# Proteksi server-side (rate limiting, blokir user) tetap aktif
# Server-side protections (rate limiting, user blocking) remain active
SECURITY_CHAT_FILTER=true

# ================================
# Pengaturan Performa / Performance Settings
# ================================
# Maksimal operasi berat bersamaan (download, scraping)
# Maximum concurrent heavy operations (downloads, scraping)
MAX_PROCESSES=3

# Cooldown antar perintah per pengguna (milidetik)
# Cooldown between commands per user (milliseconds)
# Default ramah pengguna: 3 detik
# Friendly default: 3 seconds
COOLDOWN_MS=3000

# Jendela rate limit (milidetik)
# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW=60000

# Maksimal perintah per pengguna per jendela (ramah: 15)
# Maximum commands per user per window (friendly: 15)
RATE_LIMIT_MAX=15

# Waktu kedaluwarsa cache (milidetik)
# Cache expiration time (milliseconds)
CACHE_EXPIRATION=300000

# ================================
# Pengaturan Media / Media Settings
# ================================
# Durasi maksimal musik dalam detik
# Maximum music duration in seconds
MAX_MUSIC_DURATION=600

# Ukuran file maksimal untuk download (hemat data: 200M)
# Maximum file size for downloads (data saving: 200M)
MAX_FILE_SIZE=200M

# ================================
# Pengaturan Proxy (untuk yt-dlp, APIs, Puppeteer)
# Proxy Settings (for yt-dlp, APIs, Puppeteer)
# ================================
# Aktifkan proxy secara global (set true untuk mengaktifkan)
# Enable proxy globally (set to true to activate)
PROXY_ENABLED=false

# Tipe proxy: http, https, atau socks5
# Proxy type: http, https, or socks5
# Untuk setup Tailscale + Every Proxy, gunakan socks5 atau http
# For Tailscale + Every Proxy setup, use socks5 or http
PROXY_TYPE=http

# Opsi 1: URL proxy lengkap (diprioritaskan jika diisi)
# Option 1: Full proxy URL (takes priority if set)
# Mendukung: http://host:port, socks5://host:port, http://user:pass@host:port
# Supports: http://host:port, socks5://host:port, http://user:pass@host:port
# HB_PROXY_URL=socks5://100.x.x.x:1080

# Opsi 2: Komponen individual (direkomendasikan untuk Tailscale + Every Proxy)
# Option 2: Individual components (recommended for Tailscale + Every Proxy)
# PROXY_HOST: IP Tailscale Anda (contoh: 100.x.x.x)
# PROXY_HOST: Your Tailscale IP address (e.g., 100.x.x.x)
# PROXY_PORT: Port tempat Every Proxy berjalan (contoh: 1080 untuk SOCKS5, 8080 untuk HTTP)
# PROXY_PORT: Port where Every Proxy is running (e.g., 1080 for SOCKS5, 8080 for HTTP)
PROXY_HOST=
PROXY_PORT=

# Opsional: Autentikasi proxy (jika diperlukan)
# Optional: Proxy authentication (if required)
# PROXY_USER=your_proxy_username
# PROXY_PASS=your_proxy_password

# ================================
# Panduan Setup Tailscale + Every Proxy:
# Tailscale + Every Proxy Setup Guide:
# ================================
# 1. Install Tailscale di HP cadangan dan server ini
#    Install Tailscale on your spare phone and this server
# 2. Install aplikasi Every Proxy di HP
#    Install Every Proxy app on the phone
# 3. Konfigurasi Every Proxy sebagai SOCKS5 (port 1080) atau HTTP (port 8080)
#    Configure Every Proxy as SOCKS5 (port 1080) or HTTP (port 8080)
# 4. Set PROXY_HOST ke IP Tailscale HP Anda (contoh: 100.x.x.x)
#    Set PROXY_HOST to your phone's Tailscale IP (e.g., 100.x.x.x)
# 5. Set PROXY_PORT ke port Every Proxy
#    Set PROXY_PORT to Every Proxy's port
# 6. Set PROXY_ENABLED=true
# Contoh konfigurasi:
# Example config:
#   PROXY_ENABLED=true
#   PROXY_TYPE=socks5
#   PROXY_HOST=100.64.0.2
#   PROXY_PORT=1080

# ================================
# Kunci API / API Keys
# ================================
# Google Gemini API (untuk perintah .ai)
# Google Gemini API (for .ai command)
# Dapatkan kunci di: https://aistudio.google.com/app/apikey
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs TTS API (untuk perintah .say)
# ElevenLabs TTS API (for .say command)
# Dapatkan kunci di: https://elevenlabs.io
# Get your key from: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=plgKUYgnlZ1DCNh54DwJ

# OMDb API (untuk perintah .movie)
# OMDb API (for .movie command)
# Dapatkan kunci di: http://www.omdbapi.com/apikey.aspx
# Get your key from: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# ================================
# Pengaturan Logging / Logging Settings
# ================================
# Level log: error, warn, info, debug
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Mode senyap (tanpa output konsol)
# Silent mode (no console output)
LOG_SILENT=false

# ================================
# Pengaturan Lanjutan / Advanced Settings
# ================================
# Lingkungan Node
# Node environment
NODE_ENV=production

# Batas memori (MB)
# Memory limit (MB)
NODE_OPTIONS=--max-old-space-size=2048

# Nama proses PM2 (untuk perintah .security restart/stop)
# PM2 process name (for .security restart/stop command)
PM2_PROCESS_NAME=hambot

# ================================
# Pengaturan Opsional Lanjutan
# Optional Advanced Settings
# ================================
# Interval cleanup cache (milidetik, default: 300000 = 5 menit)
# Cache cleanup interval (milliseconds, default: 300000 = 5 minutes)
# CACHE_CLEANUP_INTERVAL=300000

# Interval cleanup rate limiter (milidetik, default: 60000 = 1 menit)  
# Rate limiter cleanup interval (milliseconds, default: 60000 = 1 minute)
# RATE_LIMITER_CLEANUP_INTERVAL=60000

# Durasi blokir otomatis (milidetik, default: 1800000 = 30 menit)
# Auto-block duration (milliseconds, default: 1800000 = 30 minutes)
# AUTO_BLOCK_DURATION=1800000

# Batas aktivitas mencurigakan sebelum blokir otomatis (default: 20)
# Suspicious activity threshold before auto-block (default: 20)
# SUSPICIOUS_ACTIVITY_THRESHOLD=20
