{
  "name": "hambot",
  "version": "3.2.0",
  "private": true,
  "description": "WhatsApp bot with a modular command system, media downloading, and networking tools",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkilixCode/hambot-wa-bot.git"
  },
  "bugs": {
    "url": "https://github.com/AkilixCode/hambot-wa-bot/issues"
  },
  "homepage": "https://github.com/AkilixCode/hambot-wa-bot#readme",
  "scripts": {
    "start": "node index.js",
    "dev": "NODE_ENV=development node index.js",
    "test": "node test-system.js",
    "test:integration": "node test-integration.cjs",
    "test:security": "node test-security.cjs",
    "test:all": "npm run test && npm run test:integration && npm run test:security && npm run test:media && npm run test:commands",
    "test:verbose": "LOG_LEVEL=debug node test-system.js",
    "test:media": "node test-media.cjs",
    "test:commands": "node test-commands.cjs"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-bot",
    "baileys",
    "chatbot",
    "nodejs"
  ],
  "author": "Ilham",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "axios": "^1.19.0",
    "canvas": "^3.2.3",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.4",
    "socks-proxy-agent": "^10.1.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.5": true
  }
}
